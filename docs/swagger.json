    "definitions": {
        "controller.saveCanvasRequest": {
            "type": "object",
            "required": [
                "document",
                "title"
            ],
            "properties": {
                "document": {
                    "description": "画布文档内容，必须是合法的 JSON 对象",
                    "type": "object"
                },
                "title": {
                    "description": "画布标题",
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1,
                    "example": "我的画布"
                }
            }
        },
        "controller.submitCanvasRequest": {
            "type": "object",
            "required": [
                "access_level"
            ],
            "properties": {
                "access_level": {
                    "description": "访问级别：1 公开，2 仅发布者 VIP 可见",
                    "type": "integer",
                    "enum": [
                        1,
                        2
                    ],
                    "example": 1
                },
                "required_plan_level": {
                    "description": "access_level 为 2 时要求的 VIP 等级",
                    "type": "integer",
                    "maximum": 10,
                    "minimum": 1
                }
            }
        },
        "model.Canvas": {
            "type": "object",
            "properties": {
                "access_level": {
                    "description": "访问级别：0 私有，1 公开，2 仅发布者 VIP 可见",
                    "type": "integer",
                    "enum": [
                        0,
                        1,
                        2
                    ],
                    "example": 0
                },
                "created_at": {
                    "description": "创建时间",
                    "type": "string"
                },
                "document": {
                    "description": "画布文档内容",
                    "type": "object"
                },
                "id": {
                    "description": "画布 ID",
                    "type": "integer",
                    "example": 1
                },
                "publish_status": {
                    "description": "发布状态：0 草稿，1 待审核，2 已发布，3 已驳回",
                    "type": "integer",
                    "enum": [
                        0,
                        1,
                        2,
                        3
                    ],
                    "example": 0
                },
                "reject_reason": {
                    "description": "审核驳回原因",
                    "type": "string"
                },
                "required_plan_level": {
                    "description": "要求的发布者 VIP 等级",
                    "type": "integer",
                    "maximum": 10,
                    "minimum": 1
                },
                "reviewed_at": {
                    "description": "审核时间",
                    "type": "string"
                },
                "reviewed_by": {
                    "description": "审核人用户 ID",
                    "type": "integer"
                },
                "submitted_at": {
                    "description": "提交审核时间",
                    "type": "string"
                },
                "title": {
                    "description": "画布标题",
                    "type": "string",
                    "example": "我的画布"
                },
                "updated_at": {
                    "description": "最后更新时间",
                    "type": "string"
                },
                "user_id": {
                    "description": "所属用户 ID",
                    "type": "integer",
                    "example": 10
                }
            }
        },
        "model.CanvasSummary": {
            "type": "object",
            "properties": {
                "access_level": {
                    "description": "访问级别：0 私有，1 公开，2 仅发布者 VIP 可见",
                    "type": "integer",
                    "enum": [
                        0,
                        1,
                        2
                    ],
                    "example": 0
                },
                "created_at": {
                    "description": "创建时间",
                    "type": "string",
                    "example": "2026-09-10T10:00:00+08:00"
                },
                "id": {
                    "description": "画布 ID",
                    "type": "integer",
                    "example": 1
                },
                "publish_status": {
                    "description": "发布状态：0 草稿，1 待审核，2 已发布，3 已驳回",
                    "type": "integer",
                    "enum": [
                        0,
                        1,
                        2,
                        3
                    ],
                    "example": 0
                },
                "title": {
                    "description": "画布标题",
                    "type": "string",
                    "example": "我的画布"
                },
                "updated_at": {
                    "description": "最后更新时间",
                    "type": "string",
                    "example": "2026-09-10T12:00:00+08:00"
                }
            }
        },
        "resp.ErrorInfo": {
            "type": "object",
            "properties": {
                "code": {
                    "description": "便于程序识别的错误码",
                    "type": "string",
                    "example": "INVALID_PARAM"
                },
                "message": {
                    "description": "便于阅读的错误信息",
                    "type": "string",
                    "example": "参数无效"
                }
            }
        },
        "resp.Pagination": {
            "type": "object",
            "properties": {
                "page": {
                    "description": "当前页码",
                    "type": "integer",
                    "example": 1
                },
                "size": {
                    "description": "每页记录数",
                    "type": "integer",
                    "example": 20
                },
                "total": {
                    "description": "符合条件的记录总数",
                    "type": "integer",
                    "example": 42
                }
            }
        },
        "resp.Response": {
            "type": "object",
            "properties": {
                "data": {
                    "description": "响应数据"
                },
                "error": {
                    "description": "请求失败时的错误信息",
                    "allOf": [
                        {
                            "$ref": "#/definitions/resp.ErrorInfo"
                        }
                    ]
                },
                "pagination": {
                    "description": "列表接口的分页信息",
                    "allOf": [
                        {
                            "$ref": "#/definitions/resp.Pagination"
                        }
                    ]
                },
                "success": {
                    "description": "请求是否成功",
                    "type": "boolean",
                    "example": true
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "输入 \"Bearer {token}\"，例如：Bearer eyJhbGciOiJIUzI1Ni...",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
